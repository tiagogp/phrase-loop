  "version": 1,
  "label": {
    "pt": "Desenvolvimento de software",
    "en": "Software development"
  },
  "provenance": "Cenários: lista do responsável (12/10/2026). Funções: derivadas das descrições dos cenários, pendentes de confirmação do responsável. Expressões: geradas por modelo e conferidas por um segundo modelo; nenhuma revisada por humano.",
  "scenarios": [
    {
      "id": "daily-standup",
      "label": {
        "pt": "Daily",
        "en": "Daily stand-up"
      },
      "situation": {
        "en": "Daily stand-up of a remote software team. The learner gives their update: what they did, what they will do next and what is blocking them.",
        "pt": "Daily de um time remoto. Você dá seu update: o que fez, o que vai fazer e o que está te bloqueando."
      },
      "aiRole": "the engineering manager running the stand-up, who asks short follow-up questions about progress and blockers",
      "functions": [
        {
          "id": "report-progress",
          "label": {
            "en": "say what you finished and what is still in progress",
            "pt": "dizer o que terminou e o que ainda está em andamento"
          }
        },
        {
          "id": "plan-next",
          "label": {
            "en": "say what you will work on next",
            "pt": "dizer no que vai trabalhar em seguida"
          }
        },
        {
          "id": "flag-blocker",
          "label": {
            "en": "raise a blocker and ask for what you need",
            "pt": "avisar de um bloqueio e pedir o que precisa"
          }
        }
      ],
      "expressions": [
        {
          "text": "I wrapped up",
          "functionId": "report-progress",
          "register": "casual",
          "note": "wrap up = terminar, fechar uma tarefa",
          "reviewed": false
        },
        {
          "text": "I should have it up for review by",
          "functionId": "plan-next",
          "register": "neutral",
          "note": "abrir o PR para revisão até tal momento",
          "reviewed": false
        },
        {
          "text": "next up, I'm picking up",
          "functionId": "plan-next",
          "register": "casual",
          "note": "pick up = pegar uma tarefa/ticket",
          "reviewed": false
        },
        {
          "text": "I'm blocked on",
          "functionId": "flag-blocker",
          "register": "neutral",
          "note": "estar travado por causa de algo",
          "reviewed": false
        },
        {
          "text": "I'm waiting on",
          "functionId": "flag-blocker",
          "register": "neutral",
          "note": "estar esperando algo/alguém para seguir",
          "reviewed": false
        },
        {
          "text": "I'm still working on",
          "functionId": "report-progress",
          "register": "neutral",
          "note": "ainda estou trabalhando em",
          "reviewed": false
        }
      ]
    },
