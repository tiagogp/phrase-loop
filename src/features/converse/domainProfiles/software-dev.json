        },
        {
          "text": "would it work if we",
          "functionId": "propose-compromise",
          "register": "neutral",
          "note": "propor um meio-termo em forma de pergunta",
          "reviewed": false
        },
        {
          "text": "that said, I'm happy to",
          "functionId": "propose-compromise",
          "register": "neutral",
          "note": "dito isso, por mim tudo bem…",
          "reviewed": false
        }
